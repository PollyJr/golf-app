# --- Required -----------------------------------------------------------
# PostgreSQL connection string. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://fairway:fairway@127.0.0.1:5432/fairway_dev
# Set to "true" only when connecting over a public, TLS-only endpoint.
DATABASE_SSL=false
# Random string of at least 32 characters. Signs nothing, but keys the
# hashes used for rate limiting. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Optional second secret for hashing client IPs (falls back to SESSION_SECRET).
IP_HASH_SECRET=

# --- First deploy only (remove the passwords afterwards) -----------------
BOOTSTRAP_CLUB_NAME=Shortgolf Twente
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_PLAYER_NAME=
BOOTSTRAP_PLAYER_CODE=
BOOTSTRAP_PLAYER_PIN=
# Set to "true" to overwrite the passwords/PIN of the accounts above when
# they already exist (account recovery). Remove again after one deploy.
BOOTSTRAP_RESET_CREDENTIALS=false
