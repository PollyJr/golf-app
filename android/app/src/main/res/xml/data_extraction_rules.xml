<?xml version="1.0" encoding="utf-8"?>
<!-- The app holds nothing but the WebView's session cookie and cache: a
     signed-in session must not travel to another device through a backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="device_root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="device_root" />
    </device-transfer>
</data-extraction-rules>
